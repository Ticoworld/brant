import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {ccc} from '@ckb-ccc/core';
import {recoverR7} from '../lib/r7-recovery.ts';
import {buildR7Purchase} from '../lib/r7-buy.ts';
import {read} from '../lib/market.ts';
const dir='../../labs/wo15-merkle-intent/r7/evidence/r7-1793925991792/';
const events=JSON.parse(readFileSync(dir+'events.json','utf8'));
const result=JSON.parse(readFileSync(dir+'result.json','utf8'));
const byHash=new Map(events.map((e:any)=>[e.hash,e]));
const sale=events.find((e:any)=>e.label==='offline_sale_after_unrelated_update');
const tx=sale.tx, prior=byHash.get(tx.inputs[0].previousOutput.txHash) as any;
const buyerEvent=byHash.get(tx.inputs[1].previousOutput.txHash) as any;
const rpc=async(method:string,args:any[])=>method==='get_transaction'?(byHash.get(args[0]) as any)?.committed:method==='get_live_cell'?{status:'live',cell:{data:{content:prior.tx.outputsData[0]}}}:undefined;
const id=prior.tx.outputs[0].type.args,code=prior.tx.outputs[0].type.codeHash;
const state=await recoverR7(rpc,prior.hash,code,id,result.genesis);
const cell=(ev:any,i:number)=>ccc.Cell.from({cellOutput:ev.tx.outputs[i],outputData:ev.tx.outputsData[i],outPoint:{txHash:ev.hash,index:i}});
const vault=cell(prior,0),buyer=cell(buyerEvent,Number(tx.inputs[1].previousOutput.index));
const payload=ccc.bytesFrom(tx.witnesses.at(-1)),old=state.tree.records[0],off=16+120+32*state.tree.depth;
const terms={genesis:result.genesis,vault:id,covenant:vault.cellOutput.lock.hash(),position:'0',seller:old.owner,principal:String(old.p),backing:String(old.b),revision:String(old.revision),price:String(read(payload,off))};
const signature=ccc.hexFrom(payload.slice(off+41,off+106));
const built=buildR7Purchase({terms,signature,tree:state.tree,vault,buyer,secpDep:tx.cellDeps[0],codeDep:tx.cellDeps[1],fee:10000n});
assert.equal(built.tx.hash(),ccc.Transaction.from(tx).hash());
assert.equal(built.tx.witnesses[2],tx.witnesses[2]);
assert.throws(()=>buildR7Purchase({terms:{...terms,price:'1'},signature,tree:state.tree,vault,buyer,secpDep:tx.cellDeps[0],codeDep:tx.cellDeps[1],fee:10000n}));
console.log('R7 buyer transaction matches committed recorded sale');
