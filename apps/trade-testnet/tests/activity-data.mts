import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {activityRows,averageShannons,readActivityAttempts} from '../app/trader/activity-data.ts';
import {transactionStatus} from '../lib/r7-transaction-status.ts';
import {tradeKey} from '../lib/v2-engine/pudge-trade-journal.ts';
import type {MarketData,TradeEvent} from '../app/trader/types.ts';
const genesis='0x'+'1'.repeat(64),owner='0x'+'2'.repeat(64),other='0x'+'3'.repeat(64);
const fixture=JSON.parse(readFileSync(new URL('./fixtures/pudge-interleaved-sell.json',import.meta.url),'utf8'));
const hash=fixture.sell as string;
const event={hash,owner,status:'confirmed',quantity:'3',amountShannons:'100000001',side:'buy'} as TradeEvent;
const second={...event,owner:other,executionIndex:1,side:'sell'} as TradeEvent;
const market={historyState:'verified',history:[event,second]} as MarketData;
assert.deepEqual(activityRows(market,'market',owner,'all'),[second,event]);
assert.deepEqual(activityRows(market,'personal',owner,'all'),[event]);
assert.deepEqual(activityRows(market,'personal',other,'all'),[second]);
assert.deepEqual(activityRows(market,'market','','sell'),[second]);
assert.deepEqual(activityRows(market,'market','','buy'),[event]);
assert.deepEqual(activityRows(market,'personal','','all'),[]);
assert.equal(activityRows({...market,historyState:'unavailable'},'market','','all'),null);
assert.equal(averageShannons(event),33333334n);
const record={version:1,genesis,owner,txHash:hash,transaction:fixture.transactions[hash].transaction};
const storage=(data:unknown)=>({getItem:(key:string)=>key===tradeKey(genesis,owner)?JSON.stringify(data):null});
assert.deepEqual(readActivityAttempts(storage(record),genesis,owner,[]),[{kind:'trade',hash}]);
assert.deepEqual(readActivityAttempts(storage(record),genesis,owner,[event]),[]);
assert.deepEqual(readActivityAttempts(storage({...record,owner:other}),genesis,owner,[]),[]);
assert.deepEqual(readActivityAttempts(storage({...record,txHash:other}),genesis,owner,[]),[]);
assert.equal(transactionStatus(null),'unknown');
assert.equal(transactionStatus({error:'RPC timeout'}),'unknown');
console.log('PASS Activity scope, order, filters, exact pricing and read-only journal validation');
