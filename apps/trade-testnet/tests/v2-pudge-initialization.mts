import assert from 'node:assert/strict';
import {ccc} from '@ckb-ccc/core';
import {deriveMarketIdentity} from '../lib/v2-engine/initialization.ts';
import {preparePudgeInitializationStage} from '../lib/v2-engine/initialization-orchestrator.ts';
const genesis='0x10639e0895502b5688a6be8cf69460d76541bfa4821629d86d62ba0aae3f9606';
const codes={market:'0xdfeb6731293b4cc42bd09823806c284a7bd796ec1a88bd93769955864983a770',marker:'0xd09213f4c7755a004bb17d0866ac170b6a459e36e17a76df66079f9426604fd2',owner:'0xf8679f2ffc2a07f6ff3e8ec71ddd8eb7f807d0c0c6f3482cf9e9fbe6af57da53',custody:'0xeb824875d13277957fbca6b683cfb20d7a3232de4d1737fe5a3a20dbad858000',custodyMarker:'0x21c973369f41486cd7d45b6a8aac18894b0f8bab69aea1e023e6a639baa7eadc',xudt:'0x50bd8d6680b8b9cf98b73f3c08faf8b2a21914311954118ad6609be6e78a1b95'};
const anchor={txHash:'0x'+'11'.repeat(32),index:'0x0'},lock={codeHash:'0x9bd7e06f3ecf4be0f2fcd2188b23f1b9fcc88e5d4b65a8637b17723bbda3cce8',hashType:'type' as const,args:'0x'+'22'.repeat(20)},input={outPoint:{txHash:'0x'+'33'.repeat(32),index:'0x0'},capacity:500000000000n,lock,data:'0x'};
const secp={outPoint:{txHash:'0xf8de3bb47d055cdf460d93a2a6e1b05f7432f9777c8c474abf4eec1d4aee5d37',index:'0x0'},depType:'depGroup' as const},data='0x020000008f8c79eb6671709633fe6a46de93c0fedc9c1b8a6527a18d3983879542635c9f030000008f8c79eb6671709633fe6a46de93c0fedc9c1b8a6527a18d3983879542635c9f01000000';
const deps=[{outPoint:secp.outPoint,dataHash:ccc.hashCkb(data)}],identity=deriveMarketIdentity({anchor,genesis,base:1000000000n,step:100000000n,supply:2000n,codes});
const params={identity,anchor,inputs:[input],ownerCapacity:20000000000n,buyerCapacity:200000000000n,fee:1000000n,secpDep:secp};
const rpc=async(method:string,values:unknown[])=>{if(method==='get_block_hash')return genesis;const point=values[0] as {tx_hash:string};if(point.tx_hash===secp.outPoint.txHash)return {status:'live',cell:{data:{content:data}}};return {status:'live',cell:{output:{capacity:'0x'+input.capacity.toString(16),lock:{code_hash:lock.codeHash,hash_type:lock.hashType,args:lock.args},type:null},data:{content:'0x'}}};};
const ready=await preparePudgeInitializationStage(rpc,{stage:'setup',params},[input],deps);assert.equal(ready.stage,'setup');
await assert.rejects(()=>preparePudgeInitializationStage(rpc,{stage:'setup',params:{...params,identity:{...identity,markerData:'0x00'}}},[input],deps),/marker data/);
await assert.rejects(()=>preparePudgeInitializationStage(rpc,{stage:'setup',params:{...params,identity:{...identity,market:ccc.Script.from({...identity.market,args:'0x'+'00'.repeat(88)})}}},[input],deps),/identity/);
await assert.rejects(()=>preparePudgeInitializationStage(rpc,{stage:'setup',params:{...params,anchor:{...anchor,index:'0x1'}}},[input],deps),/anchor/);
await assert.rejects(()=>preparePudgeInitializationStage(rpc,{stage:'setup',params},[input],[{...deps[0],dataHash:'0x'+'00'.repeat(32)}]),/secp/);
await assert.rejects(()=>preparePudgeInitializationStage(async(method,values)=>method==='get_block_hash'?'0x'+'ff'.repeat(32):rpc(method,values),{stage:'setup',params},[input],deps),/genesis/);
console.log('Pudge initialization setup checks passed');
