import assert from 'node:assert/strict';
import fs from 'node:fs';
import {deriveMarketIdentity,buildInitializationSetup,buildIssuance,buildFirstPurchase} from '../lib/v2-engine/initialization.ts';
import {ccc} from '@ckb-ccc/core';
const evidenceDir=process.env.ROVEKO_INIT_EVIDENCE;
const fixture=JSON.parse(fs.readFileSync(evidenceDir ? `${evidenceDir}/browser-bootstrap.json` : new URL('../../../labs/trade-v2-token/gate2/evidence/native-1794484243927/browser-bootstrap.json',import.meta.url),'utf8'));
const anchor=fixture.scripts.owner.args.slice(2,66), idx=fixture.scripts.owner.args.slice(66,74).match(/../g).reverse().join('');
const id=deriveMarketIdentity({anchor:{txHash:'0x'+anchor,index:'0x'+idx},genesis:fixture.genesis,base:1000000000n,step:100000000n,supply:2000n,codes:{market:fixture.hashes.market_smt,marker:fixture.hashes.marker_candidate,owner:fixture.hashes.owner_lineage_candidate,custody:fixture.hashes.custody_smt,custodyMarker:fixture.hashes.custody_marker,xudt:fixture.hashes.xudt}});
for(const name of ['market','marker','owner','token','custody','custodyMarker'] as const) assert.equal(id[name].args,fixture.scripts[name].args,name);
const events=fs.readFileSync(evidenceDir ? `${evidenceDir}/events.jsonl` : new URL('../../../labs/trade-v2-token/gate2/evidence/native-1794484243927/events.jsonl',import.meta.url),'utf8').trim().split('\n').map(x=>JSON.parse(x));
const fund=events.find(x=>x.label==='fund'), issue=events.find(x=>x.label==='issue_fixed_supply'), init=events.find(x=>x.label==='initial_curve_purchase');
const cell=(e:any,i:number)=>({outPoint:{txHash:e.hash,index:'0x'+i.toString(16)},capacity:BigInt(e.tx.outputs[i].capacity),lock:e.tx.outputs[i].lock,type:e.tx.outputs[i].type,data:e.tx.outputsData[i]});
const anchorCapacity=issue.tx.outputs.reduce((s:bigint,o:any)=>s+BigInt(o.capacity),0n)+1000000n-BigInt(fund.tx.outputs[0].capacity);
const anchorCell={outPoint:issue.tx.inputs[0].previousOutput,capacity:anchorCapacity,lock:issue.tx.outputs[2].lock,data:'0x'};
const setupInput=cell(fund,5), setup=buildInitializationSetup({identity:id,anchor:anchorCell.outPoint,inputs:[setupInput],ownerCapacity:20000000000n,buyerCapacity:200000000000n,fee:1000000n,secpDep:fund.tx.cellDeps[0]});
assert.equal(setup.outputs.length,3);assert.equal(setup.outputs[0].lock.hash(),id.owner.hash());
assert.throws(()=>buildInitializationSetup({identity:id,anchor:setupInput.outPoint,inputs:[setupInput],ownerCapacity:20000000000n,buyerCapacity:200000000000n,fee:1000000n,secpDep:fund.tx.cellDeps[0]}),/reserved/);
const issued=buildIssuance({identity:id,anchor:anchorCell,ownerCell:cell(fund,0),supply:2000n,inventoryCapacity:30000000000n,markerCapacity:30000000000n,fee:1000000n,deps:issue.tx.cellDeps});
assert.equal(issued.hash(),ccc.Transaction.from(issue.tx).hash());
assert.throws(()=>buildIssuance({identity:id,anchor:anchorCell,ownerCell:cell(fund,0),supply:1999n,inventoryCapacity:30000000000n,markerCapacity:30000000000n,fee:1000000n,deps:issue.tx.cellDeps}),/supply/);
const first=buildFirstPurchase({identity:id,inventory:cell(issue,0),marker:cell(issue,1),buyer:cell(fund,1),supply:2000n,quantity:7n,price:9100000000n,custodyCapacity:35000000000n,custodyMarkerCapacity:35000000000n,fee:1000000n,newRoot:'0x'+init.tx.outputsData[2].slice(34),witness:init.tx.witnesses[3],genesis:fixture.genesis,deps:init.tx.cellDeps});
assert.equal(first.hash(),ccc.Transaction.from(init.tx).hash());
assert.throws(()=>buildFirstPurchase({identity:id,inventory:cell(issue,0),marker:cell(issue,1),buyer:cell(fund,1),supply:2000n,quantity:7n,price:1n,custodyCapacity:35000000000n,custodyMarkerCapacity:35000000000n,fee:1000000n,newRoot:'0x'+init.tx.outputsData[2].slice(34),witness:init.tx.witnesses[3],genesis:fixture.genesis,deps:init.tx.cellDeps}),/price/);
assert.throws(()=>deriveMarketIdentity({anchor:{txHash:'0x00',index:'0x0'},genesis:fixture.genesis,base:1n,step:1n,supply:1n,codes:{market:fixture.hashes.market_smt,marker:fixture.hashes.marker_candidate,owner:fixture.hashes.owner_lineage_candidate,custody:fixture.hashes.custody_smt,custodyMarker:fixture.hashes.custody_marker,xudt:fixture.hashes.xudt}}));
console.log('Gate 2 initialization identity matches native fixture');
