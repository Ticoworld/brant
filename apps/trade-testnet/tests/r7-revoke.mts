import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {ccc} from '@ckb-ccc/core';
import {recoverR7} from '../lib/r7-recovery.ts';
import {buildR7Revocation} from '../lib/r7-revoke.ts';
const dir='../../labs/wo15-merkle-intent/r7/evidence/r7-1793925991792/';
const events=JSON.parse(readFileSync(dir+'events.json','utf8')), result=JSON.parse(readFileSync(dir+'result.json','utf8'));
const byHash=new Map(events.map((e:any)=>[e.hash,e]));
const event=events.find((e:any)=>e.label==='maker_revokes_intent'),tx=event.tx;
const prior=byHash.get(tx.inputs[0].previousOutput.txHash) as any,ownerEvent=byHash.get(tx.inputs[1].previousOutput.txHash) as any;
const rpc=async(method:string,args:any[])=>method==='get_transaction'?(byHash.get(args[0]) as any)?.committed:method==='get_live_cell'?{status:'live',cell:{data:{content:prior.tx.outputsData[0]}}}:undefined;
const id=prior.tx.outputs[0].type.args,code=prior.tx.outputs[0].type.codeHash,state=await recoverR7(rpc,prior.hash,code,id,result.genesis);
const cell=(ev:any,i:number)=>ccc.Cell.from({cellOutput:ev.tx.outputs[i],outputData:ev.tx.outputsData[i],outPoint:{txHash:ev.hash,index:i}});
const vault=cell(prior,0),owner=cell(ownerEvent,Number(tx.inputs[1].previousOutput.index));
const input={genesis:result.genesis,index:0,tree:state.tree,vault,owner,secpDep:tx.cellDeps[0],codeDep:tx.cellDeps[1],fee:10000n};
const built=buildR7Revocation(input);
assert.equal(built.tx.hash(),ccc.Transaction.from(tx).hash());
assert.equal(built.tx.witnesses[2],tx.witnesses[2]);
assert.throws(()=>buildR7Revocation({...input,genesis:'0x'+'00'.repeat(32)}));
assert.throws(()=>buildR7Revocation({...input,fee:1000001n}));
console.log('R7 revocation matches committed recorded transaction');
