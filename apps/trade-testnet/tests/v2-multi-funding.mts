import assert from 'node:assert/strict';
import {ccc} from '@ckb-ccc/core';
import {selectFunding, discoverFunding} from '../lib/v2-engine/multi-funding.ts';
const lock={codeHash:'0x9bd7e06f3ecf4be0f2fcd2188b23f1b9fcc88e5d4b65a8637b17723bbda3cce8',hashType:'type',args:'0x'+'11'.repeat(20)};
const owner=ccc.Script.from(lock).hash();
const cell=(i:number,capacity:bigint)=>({outPoint:{txHash:'0x'+i.toString(16).padStart(64,'0'),index:'0x0'},capacity,lock,data:'0x'});
const cells=[cell(1,100n),cell(2,80n),cell(3,50n),{...cell(4,1000n),type:{}}];
const result=selectFunding(cells,owner,150n,20n,n=>BigInt(n));
assert.equal(result.selected.length,2); assert.equal(result.change,28n); assert.equal(result.fee,2n);
assert.equal(selectFunding(cells,owner,300n,20n,n=>BigInt(n)).deficit,93n);
assert.throws(()=>selectFunding([cells[0],cells[0]],owner,1n,1n,()=>1n),/Duplicate/);
assert.equal(selectFunding(cells,owner,150n,20n,n=>BigInt(n),[`${cells[0].outPoint.txHash}:0`]).deficit,42n);
assert.equal(selectFunding(cells,owner,150n,20n,n=>BigInt(n),[`${cells[0].outPoint.txHash}:0x00`]).deficit,42n);
assert.throws(()=>selectFunding(cells,owner,1n,1n,()=>1n,['bad']),/protected/);
const tip='0x'+'ab'.repeat(32);
const indexer=async(method:string)=>method==='get_indexer_tip'?{block_hash:tip,block_number:'0x1'}:{objects:[{out_point:{tx_hash:cells[0].outPoint.txHash,index:'0x0'}}]};
const node=async(method:string)=>method==='get_tip_header'?{hash:tip,number:'0x1'}:method==='get_block_hash'?tip:{status:'live',cell:{output:{capacity:'0x64',lock:{code_hash:lock.codeHash,hash_type:lock.hashType,args:lock.args},type:null},data:{content:'0x'}}};
assert.equal((await discoverFunding(indexer,node,lock))[0].capacity,100n);
assert.equal((await discoverFunding(indexer,async(method)=>method==='get_live_cell'?{status:'dead'}:node(method),lock)).length,0);
await assert.rejects(()=>discoverFunding(indexer,async(method)=>method==='get_live_cell'?{status:'live',cell:{output:{capacity:'0x64',lock:{code_hash:lock.codeHash,hash_type:lock.hashType,args:'0x'+'22'.repeat(20)}},data:{content:'0x'}}}:node(method),lock),/unrelated/);
await assert.rejects(()=>discoverFunding(async()=>({block_hash:'0x00',block_number:'0x1'}),node,lock),/synchronized/);
console.log('multi-cell funding selection checks passed');
