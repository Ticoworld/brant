import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {ccc} from '@ckb-ccc/core';
import {validateLocalInitialization} from '../lib/v2-engine/initialization-validation-server.ts';
const root=path.resolve('../..'), dir=process.env.ROVEKO_INIT_EVIDENCE || path.join(root,'labs/trade-v2-token/gate2/evidence/native-1794484243927');
const fixture=JSON.parse(fs.readFileSync(path.join(dir,'browser-bootstrap.json'),'utf8'));
const events=fs.readFileSync(path.join(dir,'events.jsonl'),'utf8').trim().split('\n').map(x=>JSON.parse(x));
const init=events.find((e:any)=>e.label==='initial_curve_purchase'),issue=events.find((e:any)=>e.label==='issue_fixed_supply'),fund=events.find((e:any)=>e.label==='fund');
const witness=init.tx.witnesses[3];
const proof={domain:fixture.scripts.custody.args,owner:'0x'+witness.slice(26,90),new_root:'0x'+init.tx.outputsData[2].slice(34),witness,quantity:'7',price:'9100000000'};
const other='0x'+'22'.repeat(32);
const cell=(e:any,i:number)=>({outPoint:{txHash:e.hash,index:'0x'+i.toString(16)},capacity:BigInt(e.tx.outputs[i].capacity),lock:e.tx.outputs[i].lock,type:e.tx.outputs[i].type,data:e.tx.outputsData[i]});
const inputs=[cell(issue,0),cell(issue,1),cell(fund,1)],identity=fixture.scripts;
const binDir=process.env.ROVEKO_GATE2_BINARIES || 'C:/Users/timot/Desktop/2026/CKB/trade-gate2-rebuild-closure-20261111';
const codeFiles=['market_smt','marker_candidate','custody_smt','custody_marker'].map(n=>path.join(binDir,n)).concat(path.join(root,'labs/rebuild/native/vendor/ickb/build/release/xudt'));
const codeData=codeFiles.map(p=>'0x'+fs.readFileSync(p).toString('hex'));
const deps=codeData.map((data,i)=>({outPoint:{txHash:'0x'+(i+1).toString(16).padStart(64,'0'),index:'0x0'},dataHash:ccc.hashCkb(data)}));
let calls=0;
const rpc=async(method:string,params:unknown[])=>{calls++;if(method==='get_block_hash')return fixture.genesis;const p=params[0] as {tx_hash:string;index:string};const c=inputs.find((x:any)=>x.outPoint.txHash===p.tx_hash&&BigInt(x.outPoint.index)===BigInt(p.index));const snake=(s:any)=>s&&({code_hash:s.codeHash,hash_type:s.hashType,args:s.args});if(c)return {status:'live',cell:{output:{capacity:'0x'+c.capacity.toString(16),lock:snake(c.lock),type:snake(c.type)},data:{content:c.data}}};const i=deps.findIndex(d=>d.outPoint.txHash===p.tx_hash);return i>=0?{status:'live',cell:{data:{content:codeData[i]}}}:{status:'dead'};};
