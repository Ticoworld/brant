assert.equal(calls,18);
await assert.rejects(()=>validateLocalInitialization(rpc,fixture.genesis,inputs,deps,{...proof,new_root:other},binary,identity));
await assert.rejects(()=>validateLocalInitialization(rpc,fixture.genesis,[{...inputs[0],capacity:101n},inputs[1],inputs[2]],deps,proof,binary,identity),/differs/);
await assert.rejects(()=>validateLocalInitialization(rpc,fixture.genesis,inputs,deps,{...proof,owner:other},binary,identity),/identity/);
await assert.rejects(()=>validateLocalInitialization(rpc,fixture.genesis,inputs,deps,{...proof,price:'1'},binary,identity),/curve/);
await assert.rejects(()=>validateLocalInitialization(rpc,fixture.genesis,inputs,deps.slice(1),proof,binary,identity),/dependencies/);
console.log('Local initialization validation integration passed');
