import assert from 'node:assert/strict';
import { ccc } from '@ckb-ccc/core';
import { signOrder } from '../lib/v2-engine/order.ts';
import { buildCancellation, buildOrderFill } from '../lib/v2-engine/order-transaction.ts';
const le=(v:bigint,n:number)=>Array.from({length:n},(_,i)=>Number((v>>BigInt(i*8))&255n).toString(16).padStart(2,'0')).join('');
const hash=(x:string)=>'0x'+x.repeat(64);
const sellerSigner=new ccc.SignerCkbPrivateKey(new ccc.ClientPublicTestnet(),'0x'+'01'.padStart(64,'0'));
const buyerSigner=new ccc.SignerCkbPrivateKey(new ccc.ClientPublicTestnet(),'0x'+'02'.padStart(64,'0'));
const seller=(await sellerSigner.getRecommendedAddressObj()).script, buyer=(await buyerSigner.getRecommendedAddressObj()).script;
const terms={genesis:hash('1'),market:hash('2'),asset:hash('3'),custody:hash('4'),seller:seller.hash(),revision:2n,quantity:3n,minimum:10000000000n,payout:seller.hash(),orderId:hash('7')};
const signed=await signOrder(terms,sellerSigner);
const leaf=(bal:bigint,rev:bigint)=>le(bal,8)+le(rev,8)+(bal?'01':'02')+'00'.repeat(15);
const row=(owner:string,old:bigint,rev:bigint,next:bigint)=>owner.slice(2)+leaf(old,rev)+leaf(next,rev+1n);
const oldRoot=hash('a'), newRoot=hash('b');
const proof=(op:number,rows:string[])=>({old_root:oldRoot,new_root:newRoot,contract_witness:{hex:'0x544d533101'+le(BigInt(op),1)+le(BigInt(rows.length),1)+'00'+'00000000'+rows.join('')},proof:{csmt_old_root_verified:true,csmt_new_root_verified:true}});
const cell=(n:number,lock:ccc.Script,data='0x')=>({outPoint:{txHash:'0x'+n.toString(16).padStart(64,'0'),index:'0x0'},capacity:50000000000n,lock,data});
const cells=[cell(1,buyer,'0x'+le(10n,16)+oldRoot.slice(2)),cell(2,buyer),cell(3,buyer)] as Parameters<typeof buildOrderFill>[0]['cells'];
const common={cells,genesis:terms.genesis,fee:100000n,deps:[],proof:proof(8,[row(seller.hash(),7n,2n,4n),row(buyer.hash(),3n,1n,6n)])};
const tx=buildOrderFill(common,terms,signed.signature,signed.publicKey,seller);
assert.equal(tx.inputs.length,3);assert.equal(tx.outputs.length,4);assert.equal(tx.outputs[3].capacity,terms.minimum);
assert.throws(()=>buildOrderFill(common,{...terms,quantity:2n},signed.signature,signed.publicKey,seller));
assert.throws(()=>buildOrderFill(common,terms,signed.signature,signed.publicKey,buyer));
const cancelCells=[cells[0],cells[1],cell(4,seller)] as typeof cells;
const cancel=buildCancellation({...common,cells:cancelCells,proof:proof(7,[row(seller.hash(),7n,2n,7n)])},seller.hash());
assert.equal(cancel.outputs.length,3);
assert.throws(()=>buildCancellation({...common,cells:cancelCells,proof:proof(7,[row(seller.hash(),7n,2n,6n)])},seller.hash()));
console.log('Order fill and cancellation review checks passed');
